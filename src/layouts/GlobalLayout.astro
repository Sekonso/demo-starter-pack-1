---
import "@/styles/global.css";
import { Font } from "astro:assets";
import "aos/dist/aos.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-normal" />

    <link rel="icon" href="favicon.ico" />

    <title>Kopipy</title>
  </head>

  <body class="bg-background text-foreground m-0 p-0 font-normal">
    <slot />

    <script>
      import AOS from "aos";
      AOS.init({
        duration: 700,
        once: true,
        offset: 100,
      });
    </script>
  </body>
</html>
