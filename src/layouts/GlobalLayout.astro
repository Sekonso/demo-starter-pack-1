---
import AnimateOnReveal from "@/animations/AnimateOnReveal.astro";
import "@/styles/global.css";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en" class="h-full w-full overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content="Astro v5.0.0" />
    <meta
      name="description"
      content="Discover Kopipy, a cozy coffee shop serving handcrafted coffee, quality ingredients, and a welcoming space for every moment.."
    />

    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-normal" />

    <link rel="icon" href="favicon.ico" />

    <title>Kopipy</title>
  </head>

  <body
    class="bg-background text-foreground m-0 overflow-x-hidden p-0 font-normal"
  >
    <slot />

    <AnimateOnReveal />
  </body>
</html>
