---
import Container from "@/components/utils/Container.astro";
---

<div id="about">
  <Container
    class="tablet:flex-row tablet:gap-8 tablet:items-center tablet:justify-center flex flex-col pt-8 pb-12"
  >
    <div>
      <img
        src="images/latte.webp"
        alt="image of latte coffee"
        class="tablet:w-80 w-60"
      />
    </div>
    <div class="text-foreground">
      <h2 class="text-brand-secondary text-5xl font-bold font-normal">
        About Us
      </h2>
      <div class="bg-brand-secondary mt-2 mb-4 h-2 w-40"></div>
      <p class="max-w-150 text-justify font-semibold">
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Quae sequi ex
        autem dolore reiciendis natus, quas ea, delectus ratione magnam
        perferendis omnis tempore quod corrupti temporibus iure. Laborum dolore
        doloremque, sunt repellendus itaque reiciendis fugit, labore at magnam
        aperiam, eligendi perspiciatis atque enim esse? Iusto temporibus cum
        aperiam odit? Iste.
      </p>
    </div>
  </Container>
</div>
