---
import { Image } from "astro:assets";
import Container from "@/components/utils/Container.astro";
import heroImg from "@/assets/images/hero.webp";
---

<div class="relative">
  <!-- Background image -->
  <Image
    src={heroImg}
    alt="Barista brewing a coffee"
    aria-hidden="true"
    widths={[640, 768, 1024]}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />

  <!-- Dark overlay -->
  <div
    class="absolute inset-0 z-10 bg-black/60 shadow-[inset_0_0_400px_rgba(0,0,0,0.9)]"
  >
  </div>

  <!-- Content -->
  <Container
    class="text-foreground-secondary relative z-20 flex h-150 items-end py-12"
  >
    <div data-reveal="up" class="w-full">
      <div
        class="tablet:gap-8 flex flex-row flex-wrap items-center justify-between gap-4"
      >
        <h1 class="font-display text-5xl font-bold">KOPIPY.</h1>
        <a
          href="#about"
          class="bg-brand tablet:pt-2 tablet:pb-3 rounded-sm px-6 pt-1 pb-2 font-semibold transition-all hover:scale-110 hover:cursor-pointer"
        >
          Learn More
        </a>
      </div>

      <div class="bg-background mt-4 mb-6 h-1 w-full"></div>

      <div>
        <p class="max-w-2xl">
          Warm the soul and calm the mind. Kopipy is here to be part of your
          story, accompanying every journey, every conversation, and every
          meaningful moment with each sip.
        </p>
      </div>
    </div>
  </Container>
</div>
