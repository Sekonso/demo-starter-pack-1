---
import { Image } from "astro:assets";
import Container from "@/components/utils/Container.astro";
import heroImg from "@/assets/images/hero.webp";
---

<div class="relative">
  <!-- Background image -->
  <Image
    src={heroImg}
    alt="Image of barista brewing a coffee"
    class="absolute inset-0 z-10 size-full object-cover"
  />

  <!-- Dark overlay -->
  <div
    class="absolute inset-0 z-10 bg-black/60 shadow-[inset_0_0_400px_rgba(0,0,0,0.9)]"
  >
  </div>

  <!-- Content -->
  <Container
    class="text-foreground-secondary relative z-20 flex h-150 items-end py-12"
  >
    <div class="w-full">
      <div
        class="tablet:gap-8 flex flex-row flex-wrap items-center justify-between gap-4"
      >
        <h1 class="font-display text-5xl font-bold">KOPIPY.</h1>
        <button
          class="bg-brand tablet:pt-2 tablet:pb-3 rounded-sm px-6 pt-1 pb-2 font-semibold"
        >
          Selengkapnya
        </button>
      </div>

      <div class="bg-background mt-4 mb-6 h-1 w-full"></div>

      <div>
        <p class="max-w-xl">
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Ea magnam
          voluptatem recusandae incidunt qui eum, sit perferendis accusantium,
          ullam dolorem est, modi vero quidem quis!
        </p>
      </div>
    </div>
  </Container>
</div>
