---
import Container from "@/components/utils/Container.astro";
import { Icon } from "astro-icon/components";

const reviewsList = [
  {
    desc: "Lorem, ipsum dolor sit amet consectetur adipisicing elit. Suscipit qui, doloribus eum magni doloremque iste.",
    star: 5,
  },
  {
    desc: "Lorem, ipsum dolor sit amet consectetur adipisicing elit. Suscipit qui, doloribus eum magni doloremque iste.",
    star: 4.5,
  },
  {
    desc: "Lorem, ipsum dolor sit amet consectetur adipisicing elit. Suscipit qui, doloribus eum magni doloremque iste.",
    star: 5,
  },
  {
    desc: "Lorem, ipsum dolor sit amet consectetur adipisicing elit. Suscipit qui, doloribus eum magni doloremque iste.",
    star: 4,
  },
];

function isStar(star: number, totalStar: number) {
  return star <= totalStar;
}
---

<div id="reviews" class="bg-background-secondary text-foreground-secondary">
  <Container class="tablet:flex-row tablet:gap-20 flex flex-col gap-8 py-20">
    <!-- Head -->
    <div class="flex flex-col gap-4">
      <Icon name="ph:quotes-fill" class="text-brand size-20" />
      <h2 class="text-5xl font-bold">What our customers are saying</h2>
    </div>

    <!-- Testimony -->
    <div
      class="tablet:grid-cols-2 tablet:grid-rows-2 grid grid-cols-1 grid-rows-4 gap-4"
    >
      {
        reviewsList.map((review) => {
          return (
            <div class="bg-surface-secondary flex flex-col gap-4 rounded-md px-6 py-4">
              <Icon name="ph:quotes-fill" class="text-brand size-6" />
              <span>{review.desc}</span>
              <div class="flex flex-row gap-2">
                {Array.from({ length: 5 }).map((_, idx) => {
                  if (isStar(idx + 1, review.star)) {
                    return <Icon name="mdi:star" class="text-brand size-6" />;
                  } else if (idx + 1 - review.star === 0.5) {
                    return (
                      <Icon name="mdi:star-half" class="text-brand size-6" />
                    );
                  }
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </Container>
</div>
